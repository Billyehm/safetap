{
  "forwardPorts": [
    8000
  ],
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "name": "SafeTap backend",
  "portsAttributes": {
    "8000": {
      "label": "SafeTap API",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "cd backend && pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start-backend.sh"
}