<?xml version="1.0" encoding="utf-8"?>
<!-- SosActivity: three phases shown one at a time.
     1. holdContainer: press-and-hold the ring for 3 seconds to arm.
     2. countdownContainer: 5-second countdown with a big CANCEL button.
     3. firedContainer: confirmation, who was contacted, FALSE ALARM button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- Phase 1: hold to arm -->
    <LinearLayout
        android:id="@+id/holdContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <com.safetap.SosHoldRingView
            android:id="@+id/holdRing"
            android:layout_width="240dp"
            android:layout_height="240dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="PRESS AND HOLD FOR 3 SECONDS\nTO ARM THE SOS"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="The hold prevents pocket dials.\nYou can still cancel after."
            android:textColor="#666666"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Phase 2: countdown, last chance to cancel -->
    <LinearLayout
        android:id="@+id/countdownContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            android:textColor="@color/sos_red"
            android:textSize="120sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="SOS FIRES IN"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="48dp"
            android:text="CANCEL"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Phase 3: alert fired, show status and the false-alarm escape hatch -->
    <ScrollView
        android:id="@+id/firedContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOS SENT"
                android:textColor="@color/sos_red"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/firedStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Your location is streaming every 15 seconds.\nKeep the phone on."
                android:textColor="#666666"
                android:textSize="14sp" />

            <Button
                android:id="@+id/falseAlarmButton"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/checkin_green"
                android:text="FALSE ALARM, I'M FINE"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
